import React, { useEffect, useMemo, useState } from "react";
import { CheckCircle2, Edit3, FileDown, Plus, Printer, Trash2 } from "lucide-react";
import { toast } from "sonner";
import { Button, Card, Input, Label, Select } from "@/components/ui-bits";
import {
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import {
  deleteClinicalRecord,
  deleteTreatmentPlanItem,
  saveTreatmentPlanItem,
  uploadPatientFile,
  usePatients,
  useProcedures,
  useTreatmentPlans,
} from "@/lib/db";
import { PATIENT_STATUS, type PatientStatus, type TreatmentPlanItem, uid } from "@/lib/store";
import { formatCurrency } from "@/lib/utils";
import { supabase } from "@/integrations/supabase/client";

const db = supabase as any;
import { createBudgetPdfFile, openBudgetPdf, type BudgetPdfInput } from "@/lib/budget-pdf";

interface Props {
  patientId: string;
}

type InternalTab = "plano" | "orcamento";
type ItemStatus = TreatmentPlanItem["status"];

const TOOTH_NUMBERS = [
  "18",
  "17",
  "16",
  "15",
  "14",
  "13",
  "12",
  "11",
  "21",
  "22",
  "23",
  "24",
  "25",
  "26",
  "27",
  "28",
  "48",
  "47",
  "46",
  "45",
  "44",
  "43",
  "42",
  "41",
  "31",
  "32",
  "33",
  "34",
  "35",
  "36",
  "37",
  "38",
];

const LINK_MARKER_PREFIX = "[[ORALIT_TP_ITEM:";

function getLinkMarker(itemId: string) {
  return `${LINK_MARKER_PREFIX}${itemId}]]`;
}

function getItemLabel(item: TreatmentPlanItem, procedures: { id: string; name: string }[]) {
  return (
    item.description ||
    item.procedureName ||
    procedures.find((procedure) => procedure.id === item.procedureId)?.name ||
    "Procedimento"
  );
}

function parseTeeth(value?: string) {
  return (value || "")
    .split(",")
    .map((tooth) => tooth.trim())
    .filter(Boolean);
}

function statusLabel(status: PatientStatus) {
  if (status === "em tratamento") return "Em Tratamento";
  if (status === "em acompanhamento") return "Em Acompanhamento";
  if (status === "marcar c/ parceiros") return "Marcar c/ Parceiros";
  return "Inativo";
}

export function TreatmentPlanTab({ patientId }: Props) {
  const [plans, error, loading, tablesMissing, refetchPlans] = useTreatmentPlans(patientId);
  const [procedures] = useProcedures();
  const [patients, setPatients] = usePatients();
  const patient = patients.find((item) => item.id === patientId);

  const [internalTab, setInternalTab] = useState<InternalTab>("plano");
  const [isItemModalOpen, setIsItemModalOpen] = useState(false);
  const [itemDraft, setItemDraft] = useState<Partial<TreatmentPlanItem>>({});
  const [useTeeth, setUseTeeth] = useState(false);
  const [selectedTeeth, setSelectedTeeth] = useState<string[]>([]);
  const [savingItem, setSavingItem] = useState(false);
  const [busyItemId, setBusyItemId] = useState<string | null>(null);
  const [statusBusy, setStatusBusy] = useState(false);
  const [patientStatus, setPatientStatus] = useState<PatientStatus>("em tratamento");
  const [priceDrafts, setPriceDrafts] = useState<Record<string, string>>({});
  const [optimisticStatuses, setOptimisticStatuses] = useState<Record<string, ItemStatus>>({});
  const [documentBusy, setDocumentBusy] = useState<"preview" | "save" | null>(null);

  const allItems = useMemo(
    () =>
      plans
        .flatMap((plan) => plan.items || [])
        .sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()),
    [plans],
  );

  useEffect(() => {
    if (patient?.status) setPatientStatus(patient.status);
  }, [patient?.status]);

  useEffect(() => {
    setPriceDrafts((current) => {
      const next: Record<string, string> = {};
      for (const item of allItems) {
        next[item.id] = Object.prototype.hasOwnProperty.call(current, item.id)
          ? current[item.id]
          : String(item.estimatedPrice || 0);
      }
      return next;
    });
  }, [allItems]);

  useEffect(() => {
    setOptimisticStatuses((current) => {
      const next = { ...current };
      let changed = false;
      for (const item of allItems) {
        if (next[item.id] && next[item.id] === item.status) {
          delete next[item.id];
          changed = true;
        }
      }
      return changed ? next : current;
    });
  }, [allItems]);

  const effectiveStatus = (item: TreatmentPlanItem) => optimisticStatuses[item.id] || item.status;

  const parseCurrencyDraft = (value?: string) => {
    if (!value?.trim()) return 0;

    const normalized = value
      .replace(/\./g, "")
      .replace(",", ".");

    const parsed = Number(normalized);
    return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
  };

  const formatCurrencyDraft = (value: number) => {
    if (!Number.isFinite(value) || value <= 0) return "";

    return value.toLocaleString("pt-BR", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  };

  const amountFor = (item: TreatmentPlanItem) => {
    const draft = priceDrafts[item.id];

    if (draft !== undefined) {
      return parseCurrencyDraft(draft);
    }

    return Math.max(0, Number(item.estimatedPrice || 0));
  };

  const totalBudget = allItems.reduce((sum, item) => sum + amountFor(item), 0);

  const ensurePlanId = async () => {
    if (plans[0]?.id) return plans[0].id;

    const { data: userData } = await db.auth.getUser();
    if (!userData.user) throw new Error("Não autenticado");

    const { data, error: insertError } = await db
      .from("treatment_plans")
      .insert({
        user_id: userData.user.id,
        patient_id: patientId,
        title: "Plano de Tratamento",
        diagnosis: null,
        notes: null,
        status: "planejado",
        start_date: new Date().toISOString().split("T")[0],
        expected_end_date: null,
      })
      .select("id")
      .single();

    if (insertError) throw insertError;
    return data.id as string;
  };

  const openNewItemModal = () => {
    setItemDraft({
      priority: "média",
      status: "planejado",
      estimatedPrice: 0,
    });
    setUseTeeth(false);
    setSelectedTeeth([]);
    setIsItemModalOpen(true);
  };

  const openEditItemModal = (item: TreatmentPlanItem) => {
    const teeth = parseTeeth(item.toothNumber);
    setItemDraft({
      ...item,
      description: getItemLabel(item, procedures),
      status: effectiveStatus(item),
    });
    setUseTeeth(teeth.length > 0);
    setSelectedTeeth(teeth);
    setIsItemModalOpen(true);
  };

  const toggleTooth = (tooth: string) => {
    setSelectedTeeth((current) =>
      current.includes(tooth) ? current.filter((item) => item !== tooth) : [...current, tooth],
    );
  };

  const findLinkedClinicalRecords = async (itemId: string) => {
    const { data: userData } = await db.auth.getUser();
    if (!userData.user) throw new Error("Não autenticado");

    const { data, error: queryError } = await db
      .from("clinical_records")
      .select("id, real_cost, notes")
      .eq("user_id", userData.user.id)
      .eq("patient_id", patientId)
      .ilike("notes", `%${getLinkMarker(itemId)}%`);

    if (queryError) throw queryError;
    return data || [];
  };

  const removeLinkedClinicalRecord = async (itemId: string) => {
    const linked = await findLinkedClinicalRecords(itemId);
    for (const record of linked) {
      await deleteClinicalRecord(record.id);
    }
  };

  const upsertLinkedClinicalRecord = async (item: TreatmentPlanItem, amount: number) => {
    const { data: userData } = await db.auth.getUser();
    if (!userData.user) throw new Error("Não autenticado");

    const linked = await findLinkedClinicalRecords(item.id);
    const label = getItemLabel(item, procedures);
    const teeth = parseTeeth(item.toothNumber);
    const marker = getLinkMarker(item.id);

    if (linked.length === 0) {
      const { error: insertError } = await db.from("clinical_records").insert({
        user_id: userData.user.id,
        patient_id: patientId,
        procedure_id: item.procedureId || null,
        record_date: new Date().toISOString().split("T")[0],
        teeth,
        description: label,
        notes: marker,
        charged_amount: amount,
        real_cost: 0,
        estimated_profit: amount,
        signature: null,
      });

      if (insertError) throw insertError;
      return;
    }

    const [primary, ...duplicates] = linked;
    const realCost = Number(primary.real_cost || 0);
    const existingNotes = String(primary.notes || "").trim();
    const notes = existingNotes.includes(marker)
      ? existingNotes
      : [marker, existingNotes].filter(Boolean).join("\n");

    const { error: updateError } = await db
      .from("clinical_records")
      .update({
        procedure_id: item.procedureId || null,
        teeth,
        description: label,
        notes,
        charged_amount: amount,
        estimated_profit: amount - realCost,
        updated_at: new Date().toISOString(),
      })
      .eq("id", primary.id)
      .eq("user_id", userData.user.id);

    if (updateError) throw updateError;

    for (const duplicate of duplicates) {
      await deleteClinicalRecord(duplicate.id);
    }
  };

  const handleSaveItem = async () => {
    if (savingItem) return;
    if (!itemDraft.description?.trim()) {
      toast.error("Digite o procedimento.");
      return;
    }

    try {
      setSavingItem(true);
      const treatmentPlanId = itemDraft.treatmentPlanId || (await ensurePlanId());
      const now = new Date().toISOString();
      const item: TreatmentPlanItem = {
        id: itemDraft.id || `temp-${uid()}`,
        userId: itemDraft.userId || "",
        treatmentPlanId,
        procedureId: undefined,
        toothNumber: useTeeth && selectedTeeth.length > 0 ? selectedTeeth.join(", ") : undefined,
        toothRegion: undefined,
        description: itemDraft.description.trim(),
        priority: itemDraft.priority || "média",
        estimatedPrice: Number(itemDraft.estimatedPrice || 0),
        status: itemDraft.status || "planejado",
        createdAt: itemDraft.createdAt || now,
        updatedAt: now,
      };

      await saveTreatmentPlanItem(item);
      if (item.id && !item.id.startsWith("temp-") && item.status === "concluído") {
        await upsertLinkedClinicalRecord(item, amountFor(item));
      }

      toast.success(itemDraft.id ? "Procedimento atualizado." : "Procedimento adicionado.");
      setIsItemModalOpen(false);
      refetchPlans();
    } catch (saveError: any) {
      toast.error(saveError?.message || "Não foi possível salvar o procedimento.");
    } finally {
      setSavingItem(false);
    }
  };

  const handleDeleteItem = async (item: TreatmentPlanItem) => {
    try {
      setBusyItemId(item.id);
      await removeLinkedClinicalRecord(item.id);
      await deleteTreatmentPlanItem(item.id);
      setOptimisticStatuses((current) => {
        const next = { ...current };
        delete next[item.id];
        return next;
      });
      toast.success("Procedimento removido.");
      refetchPlans();
    } catch (deleteError: any) {
      toast.error(deleteError?.message || "Não foi possível remover o procedimento.");
    } finally {
      setBusyItemId(null);
    }
  };

  const saveItemPrice = async (item: TreatmentPlanItem) => {
    const amount = amountFor(item);
    const status = effectiveStatus(item);
    await saveTreatmentPlanItem({
      ...item,
      estimatedPrice: amount,
      status,
      updatedAt: new Date().toISOString(),
    });

    if (status === "concluído") {
      await upsertLinkedClinicalRecord({ ...item, status, estimatedPrice: amount }, amount);
    }

    refetchPlans();
    return amount;
  };

  const handlePerformedChange = async (item: TreatmentPlanItem, checked: boolean) => {
    const previousStatus = effectiveStatus(item);
    const nextStatus: ItemStatus = checked ? "concluído" : "planejado";
    const amount = amountFor(item);

    setOptimisticStatuses((current) => ({ ...current, [item.id]: nextStatus }));
    setBusyItemId(item.id);

    try {
      await saveTreatmentPlanItem({
        ...item,
        estimatedPrice: amount,
        status: nextStatus,
        updatedAt: new Date().toISOString(),
      });

      if (checked) {
        await upsertLinkedClinicalRecord(
          { ...item, estimatedPrice: amount, status: nextStatus },
          amount,
        );
        toast.success("Procedimento enviado para a ficha clínica e o financeiro.");
      } else {
        await removeLinkedClinicalRecord(item.id);
        toast.success("Procedimento marcado como não realizado.");
      }

      refetchPlans();
    } catch (syncError: any) {
      setOptimisticStatuses((current) => ({ ...current, [item.id]: previousStatus }));
      toast.error(syncError?.message || "Não foi possível sincronizar o procedimento.");
    } finally {
      setBusyItemId(null);
    }
  };

  const handlePatientStatusChange = async (nextStatus: PatientStatus) => {
    if (!patient || statusBusy || nextStatus === patientStatus) return;
    const previous = patientStatus;
    setPatientStatus(nextStatus);

    try {
      setStatusBusy(true);
      await setPatients((current) =>
        current.map((item) => (item.id === patientId ? { ...item, status: nextStatus } : item)),
      );
      toast.success("Status do paciente atualizado.");
    } catch (statusError: any) {
      setPatientStatus(previous);
      toast.error(statusError?.message || "Não foi possível atualizar o status do paciente.");
    } finally {
      setStatusBusy(false);
    }
  };

  const getBudgetPdfInput = (): BudgetPdfInput => ({
    patientName: patient?.fullName || "Paciente",
    items: allItems.map((item) => ({
      description: getItemLabel(item, procedures),
      teeth: item.toothNumber || "—",
      value: amountFor(item),
    })),
    total: totalBudget,
    issuedAt: new Date(),
    notes: "Este orçamento apresenta os procedimentos planejados e seus respectivos valores.",
  });

  const handlePreviewBudget = () => {
    if (allItems.length === 0) {
      toast.error("Adicione pelo menos um procedimento antes de gerar o orçamento.");
      return;
    }

    try {
      setDocumentBusy("preview");
      openBudgetPdf(getBudgetPdfInput());
    } catch (pdfError: any) {
      toast.error(pdfError?.message || "Não foi possível gerar o orçamento.");
    } finally {
      setDocumentBusy(null);
    }
  };

  const handleSaveBudgetDocument = async () => {
    if (allItems.length === 0) {
      toast.error("Adicione pelo menos um procedimento antes de gerar o orçamento.");
      return;
    }

    try {
      setDocumentBusy("save");
      const file = createBudgetPdfFile(getBudgetPdfInput());
      await uploadPatientFile(
        patientId,
        file,
        "documento",
        "orçamento",
        `Orçamento Oralit gerado em ${new Date().toLocaleDateString("pt-BR")}.`,
      );
      toast.success("Orçamento salvo nos Documentos do paciente.");
    } catch (documentError: any) {
      toast.error(documentError?.message || "Não foi possível salvar o orçamento em Documentos.");
    } finally {
      setDocumentBusy(null);
    }
  };

  if (loading) {
    return (
      <div className="py-10 text-center text-sm font-medium text-muted-foreground">
        Carregando plano de tratamento...
      </div>
    );
  }

  if (tablesMissing) {
    return (
      <div className="rounded-xl border border-rose-200 bg-rose-50 p-6 text-center text-rose-700">
        Estrutura do plano de tratamento indisponível.
      </div>
    );
  }

  if (error) {
    return (
      <div className="rounded-xl border border-rose-200 bg-rose-50 p-6 text-center text-rose-700">
        {error}
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="flex border-b border-border">
        <button
          type="button"
          onClick={() => setInternalTab("plano")}
          className={`border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors ${
            internalTab === "plano"
              ? "border-[#C9A227] text-[#C9A227]"
              : "border-transparent text-muted-foreground hover:text-foreground"
          }`}
        >
          Plano de Tratamento
        </button>
        <button
          type="button"
          onClick={() => setInternalTab("orcamento")}
          className={`border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors ${
            internalTab === "orcamento"
              ? "border-[#C9A227] text-[#C9A227]"
              : "border-transparent text-muted-foreground hover:text-foreground"
          }`}
        >
          Orçamento
        </button>
      </div>

      {internalTab === "plano" ? (
        <div className="space-y-4">
          <div className="flex flex-col gap-3 rounded-xl border border-border bg-[#fcfbf8] p-4 sm:flex-row sm:items-end sm:justify-between">
            <div className="w-full max-w-sm">
              <div className="mb-1.5 block text-xs font-bold uppercase tracking-wide text-[#8A6A16]">
                Status do paciente
              </div>
              <Select
                value={patientStatus}
                onChange={(event) =>
                  void handlePatientStatusChange(event.target.value as PatientStatus)
                }
                disabled={statusBusy || !patient}
                className="h-10 bg-white"
              >
                {PATIENT_STATUS.map((status) => (
                  <option key={status} value={status}>
                    {statusLabel(status)}
                  </option>
                ))}
              </Select>
            </div>

            <Button
              type="button"
              className="bg-[#C9A227] font-semibold text-white hover:bg-[#b59122]"
              onClick={openNewItemModal}
            >
              <Plus className="mr-2 h-4 w-4" />
              Adicionar procedimento
            </Button>
          </div>

          <Card className="overflow-hidden border border-border bg-white p-0">
            <div className="overflow-x-auto">
              <div className="min-w-[760px]">
                <div className="grid grid-cols-[minmax(260px,1fr)_minmax(140px,210px)_300px] border-b border-border bg-secondary/30 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  <span>Procedimento</span>
                  <span>Dentes</span>
                  <span className="text-right">Realização e ações</span>
                </div>

                {allItems.length === 0 ? (
                  <div className="p-10 text-center text-sm text-muted-foreground">
                    Nenhum procedimento adicionado.
                  </div>
                ) : (
                  <div className="divide-y divide-border">
                    {allItems.map((item) => {
                      const performed = effectiveStatus(item) === "concluído";
                      const busy = busyItemId === item.id;

                      return (
                        <div
                          key={item.id}
                          className={`grid grid-cols-[minmax(260px,1fr)_minmax(140px,210px)_300px] items-center gap-3 px-4 py-3 transition-colors ${
                            performed
                              ? "border-l-4 border-l-emerald-500 bg-emerald-50/70"
                              : "border-l-4 border-l-transparent bg-white"
                          }`}
                        >
                          <div className="min-w-0">
                            <div
                              className={`truncate text-sm font-semibold ${performed ? "text-emerald-900" : "text-foreground"}`}
                            >
                              {getItemLabel(item, procedures)}
                            </div>
                            {performed && (
                              <div className="mt-1 flex items-center gap-1 text-[11px] font-semibold text-emerald-700">
                                <CheckCircle2 className="h-3.5 w-3.5" /> Enviado para Ficha Clínica
                                e Financeiro
                              </div>
                            )}
                          </div>

                          <span className="text-sm text-muted-foreground">
                            {item.toothNumber || "—"}
                          </span>

                          <div className="flex items-center justify-end gap-1.5">
                            <button
                              type="button"
                              disabled={busy}
                              onClick={() => void handlePerformedChange(item, !performed)}
                              className={`inline-flex h-8 items-center gap-1.5 rounded-lg border px-2.5 text-xs font-bold transition ${
                                performed
                                  ? "border-emerald-300 bg-emerald-600 text-white hover:bg-emerald-700"
                                  : "border-[#d8c178] bg-[#fffaf0] text-[#8A6A16] hover:bg-[#fff4d4]"
                              } disabled:cursor-wait disabled:opacity-60`}
                            >
                              <CheckCircle2 className="h-3.5 w-3.5" />
                              {performed ? "Realizado" : "Marcar realizado"}
                            </button>
                            <Button
                              type="button"
                              variant="ghost"
                              size="sm"
                              className="h-8 w-8 p-0"
                              onClick={() => openEditItemModal(item)}
                              disabled={busy}
                              title="Editar procedimento"
                            >
                              <Edit3 className="h-4 w-4" />
                            </Button>
                            <Button
                              type="button"
                              variant="ghost"
                              size="sm"
                              className="h-8 w-8 p-0 text-rose-600 hover:bg-rose-50 hover:text-rose-700"
                              disabled={busy}
                              onClick={() => void handleDeleteItem(item)}
                              title="Excluir procedimento"
                            >
                              <Trash2 className="h-4 w-4" />
                            </Button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </div>
          </Card>
        </div>
      ) : (
        <div className="space-y-4">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 className="font-display text-lg font-bold text-foreground">
                Orçamento do tratamento
              </h3>
              <p className="mt-1 text-xs text-muted-foreground">
                Informe os valores dos procedimentos do tratamento.
              </p>
            </div>
          </div>

          <Card className="overflow-hidden border border-border bg-white p-0">
            <div className="overflow-x-auto">
              <div className="min-w-[680px]">
                <div className="grid grid-cols-[minmax(280px,1fr)_minmax(120px,180px)_minmax(150px,190px)] items-center border-b border-border bg-secondary/30 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  <span>Procedimento</span>
                  <span>Dentes</span>
                  <span>Valor</span>
                </div>

                {allItems.length === 0 ? (
                  <div className="p-10 text-center text-sm text-muted-foreground">
                    Nenhum procedimento adicionado.
                  </div>
                ) : (
                  <div className="divide-y divide-border">
                    {allItems.map((item) => (
                      <div
                        key={item.id}
                        className="grid grid-cols-[minmax(280px,1fr)_minmax(120px,180px)_minmax(150px,190px)] items-center gap-3 px-4 py-3"
                      >
                        <span className="truncate text-sm font-medium text-foreground">
                          {getItemLabel(item, procedures)}
                        </span>
                        <span className="text-sm text-muted-foreground">
                          {item.toothNumber || "—"}
                        </span>
                        <div className="relative">
                          <span className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted-foreground">
                            R$
                          </span>
                          <Input
                            type="text"
                            inputMode="decimal"
                            placeholder="0,00"
                            value={priceDrafts[item.id] ?? ""}
                            onChange={(event) => {
                              const raw = event.target.value;

                              let sanitized = raw
                                .replace(/[^0-9,.]/g, "")
                                .replace(/\./g, ",");

                              const firstComma = sanitized.indexOf(",");

                              if (firstComma !== -1) {
                                sanitized =
                                  sanitized.slice(0, firstComma + 1) +
                                  sanitized
                                    .slice(firstComma + 1)
                                    .replace(/,/g, "")
                                    .slice(0, 2);
                              }

                              sanitized = sanitized.replace(/^0+(?=\d)/, "");

                              setPriceDrafts((current) => ({
                                ...current,
                                [item.id]: sanitized,
                              }));
                            }}
                            onFocus={(event) => {
                              event.currentTarget.select();
                            }}
                            onBlur={() => {
                              const amount = amountFor(item);

                              setPriceDrafts((current) => ({
                                ...current,
                                [item.id]: formatCurrencyDraft(amount),
                              }));

                              void saveItemPrice(item);
                            }}
                            className="h-9 pl-10"
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                <div className="flex items-center justify-between border-t border-border bg-[#fcfbf8] px-4 py-4">
                  <span className="text-sm font-semibold text-foreground">Total do orçamento</span>
                  <span className="text-lg font-bold text-[#8A6A16]">
                    {formatCurrency(totalBudget)}
                  </span>
                </div>
              </div>
            </div>
          </Card>
        </div>
      )}

      <Dialog open={isItemModalOpen} onOpenChange={setIsItemModalOpen}>
        <DialogContent className="max-w-2xl">
          <DialogHeader>
            <DialogTitle>
              {itemDraft.id ? "Editar procedimento" : "Adicionar procedimento"}
            </DialogTitle>
          </DialogHeader>

          <div className="space-y-5 py-3">
            <div>
              <Label>Procedimento</Label>
              <Input
                value={itemDraft.description || ""}
                onChange={(event) =>
                  setItemDraft((current) => ({
                    ...current,
                    procedureId: undefined,
                    description: event.target.value,
                  }))
                }
                placeholder="Digite o procedimento"
                autoFocus
              />
            </div>

            <div className="flex items-center justify-between rounded-xl border border-border px-4 py-3">
              <span className="text-sm font-medium text-foreground">Selecionar dentes</span>
              <input
                type="checkbox"
                checked={useTeeth}
                onChange={(event) => {
                  setUseTeeth(event.target.checked);
                  if (!event.target.checked) setSelectedTeeth([]);
                }}
                className="h-5 w-5 accent-[#C9A227]"
              />
            </div>

            {useTeeth && (
              <div className="grid grid-cols-8 gap-2 rounded-xl border border-border bg-secondary/20 p-3">
                {TOOTH_NUMBERS.map((tooth) => {
                  const selected = selectedTeeth.includes(tooth);
                  return (
                    <button
                      key={tooth}
                      type="button"
                      onClick={() => toggleTooth(tooth)}
                      className={`h-9 rounded-lg border text-sm font-semibold transition ${
                        selected
                          ? "border-[#C9A227] bg-[#fff7dc] text-[#8A6A16]"
                          : "border-border bg-white text-foreground hover:border-[#C9A227]/60"
                      }`}
                    >
                      {tooth}
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          <DialogFooter>
            <Button type="button" variant="outline" onClick={() => setIsItemModalOpen(false)}>
              Cancelar
            </Button>
            <Button
              type="button"
              className="bg-[#C9A227] font-semibold text-white hover:bg-[#b59122]"
              disabled={savingItem}
              onClick={() => void handleSaveItem()}
            >
              {savingItem ? "Salvando..." : "Salvar"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
